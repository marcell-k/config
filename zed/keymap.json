// Zed keymap
//
// For information on binding keys, see the Zed
// documentation: https://zed.dev/docs/key-bindings
//
// To see the default key bindings run `zed: open default keymap`
// from the command palette.
[
  {
    "context": "VimControl && !menu",
    "bindings": {
      "é": "vim::EndOfLine",
    },
  },
  {
    "context": "Editor && vim_mode == normal && !VimWaiting && !menu",
    "bindings": {
      // grep (<leader>sg)
      "space s g": "workspace::NewSearch",

      // LSP
      "space c a": "editor::ToggleCodeActions",
    },
  },
  {
    // move the current line / indent it (normal mode)
    "context": "Editor && vim_mode == normal && !menu",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "alt-h": ["workspace::SendKeystrokes", "< <"],
      "alt-l": ["workspace::SendKeystrokes", "> >"],
    },
  },
  {
    // move the selected lines / indent them (visual, visual-line, visual-block)
    "context": "Editor && (vim_mode == visual || vim_mode == visual_line || vim_mode == visual_block) && !VimWaiting && !menu",
    "bindings": {
      "alt-j": "editor::MoveLineDown",
      "alt-k": "editor::MoveLineUp",
      "alt-h": ["workspace::SendKeystrokes", "< g v"],
      "alt-l": ["workspace::SendKeystrokes", "> g v"],
    },
  },
  {
    // free ctrl-j/k in insert mode so they don't join lines
    "context": "Editor && vim_mode == insert",
    "bindings": {
      "ctrl-j": null,
      "ctrl-k": null,
    },
  },
  {
    // ctrl-j/k in completions and code actions menus (keep last so it wins)
    "context": "Editor && (showing_code_actions || showing_completions)",
    "bindings": {
      "ctrl-j": "editor::ContextMenuNext",
      "ctrl-k": "editor::ContextMenuPrevious",
    },
  },
  {
    "context": "Workspace",
    "bindings": {
      "cmd-shift-g": "git_panel::ToggleFocus",
    },
  },
  {
    "context": "Workspace",
    "unbind": {
      "ctrl-shift-g": "git_panel::ToggleFocus",
    },
  },
]
